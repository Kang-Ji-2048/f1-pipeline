DATABASE_URL=postgresql://f1user:f1pass@localhost:5432/f1data
ERGAST_BASE_URL=https://ergast.com/api/f1
OPENF1_BASE_URL=https://api.openf1.org/v1
LOG_LEVEL=INFO
BATCH_SIZE=500
MAX_RETRIES=3
RETRY_BACKOFF=2.0

# Real-time ingestion
LIVE_POLL_INTERVAL=5.0

# AWS S3 export (used by `f1-pipeline export-s3`). Credentials are resolved by
# boto3 from the standard AWS environment / instance role, not from here.
S3_BUCKET=
S3_PREFIX=f1-pipeline
